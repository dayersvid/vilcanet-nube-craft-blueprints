; Plantilla del instalador de Vilcanet Nube.
; Sale de bin/Packager/Nsis/NullsoftInstaller.nsi de Craft (misma licencia) con estos cambios:
;   - paginas en espanol y textos propios traducidos;
;   - lateral, cabecera e icono de la marca (tambien en el desinstalador);
;   - sin la linea "Generated by Craft";
;   - registra las extensiones del Explorador (iconos de estado y menu del boton derecho)
;     al instalar y las quita al desinstalar.
; Este archivo va solo en ASCII: Craft lo reescribe sin marca de codificacion. Las letras
; con tilde de los textos propios se escriben como ${U+xxxx}.

Unicode true

; registry stuff
!define regkey "Software\@{company}\@{productname}"
!define uninstkey "Software\Microsoft\Windows\CurrentVersion\Uninstall\@{productname}"

BrandingText "@{productname} @{version}"

;--------------------------------

XPStyle on
ManifestDPIAware true


Name "@{productname}"
Caption "@{productname} @{version}"

OutFile "@{setupname}"

!define MULTIUSER_EXECUTIONLEVEL Highest
!define MULTIUSER_MUI
!define MULTIUSER_INSTALLMODE_COMMANDLINE
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_KEY "${regkey}"
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_VALUENAME "Install_Mode"
!define MULTIUSER_INSTALLMODE_INSTDIR "@{productname}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_KEY "${regkey}"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_VALUENAME "Install_Dir"

;Start Menu Folder Page Configuration
Var StartMenuFolder
!define MUI_STARTMENUPAGE_REGISTRY_ROOT "SHCTX"
!define MUI_STARTMENUPAGE_REGISTRY_KEY "${regkey}"
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "Start Menu Folder"

;!define MULTIUSER_USE_PROGRAMFILES64
@{multiuser_use_programfiles64}
;!define MULTIUSER_USE_PROGRAMFILES64

@{nsis_include_internal}
@{nsis_include}

!include "MultiUser.nsh"
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
!include "WordFunc.nsh"

;--------------------------------
; Programa abierto: se avisa y se cierra antes de tocar archivos.
; Mismo mecanismo que process.nsh de Craft, con el aviso en espanol.

!define VilcanetPowerShell "$WINDIR\sysnative\WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy ByPass -Command"

Var ProcessList

!macro VilcanetCerrarProcesos root
    nsExec::ExecToLog '${VilcanetPowerShell} "&{ Get-Process * | Where-Object { $$_.Path -Like (Join-Path \"${root}\" *) } |  %{ Write-Host \"cerrando\", $$_.Path; Stop-Process $$_ } }"'
    Pop $0
!macroend

!macro VilcanetListarProcesos root
    nsExec::ExecToStack '${VilcanetPowerShell} "&{ Get-Process * | Where-Object { $$_.Path -Like (Join-Path \"${root}\" *) } |  %{ Write-Host $$_.Path } }"'
    Pop $0
    Pop $1
    StrCpy $ProcessList $1
!macroend

!macro VilcanetCerrarConAviso
IfFileExists $INSTDIR retry_kill
Goto end_kill
retry_kill:
    !insertmacro VilcanetListarProcesos "$INSTDIR"
    ${If} $ProcessList != ""
        MessageBox MB_YESNOCANCEL "$(VN_ABIERTO)" /SD IDYES IDNO retry_kill IDCANCEL abort_kill
        !insertmacro VilcanetCerrarProcesos "$INSTDIR"
        Goto retry_kill
        abort_kill:
            Quit
    ${EndIf}
end_kill:
!macroend

;--------------------------------
; Extensiones del Explorador (NCOverlays.dll y NCContextMenu.dll).
; Las dos exportan DllRegisterServer: se registran con el regsvr32 de 64 bits.
; Escriben en HKLM y HKCR: solo se registran en la instalacion para todos los usuarios.

!define VilcanetRegsvr "$WINDIR\sysnative\regsvr32.exe"

!macro VilcanetRegistrarExtension archivo
    ${If} ${FileExists} "$INSTDIR\bin\${archivo}"
        nsExec::ExecToLog '"${VilcanetRegsvr}" /s "$INSTDIR\bin\${archivo}"'
        Pop $0
        DetailPrint "$(VN_EXTENSION) ${archivo}: $0"
    ${EndIf}
!macroend

!macro VilcanetQuitarExtension archivo
    ${If} ${FileExists} "$INSTDIR\bin\${archivo}"
        nsExec::ExecToLog '"${VilcanetRegsvr}" /s /u "$INSTDIR\bin\${archivo}"'
        Pop $0
    ${EndIf}
!macroend

; El Explorador puede tener cargada la biblioteca: si no se deja borrar, se renombra
; (Windows lo permite) y se borra en el proximo reinicio, para que la version nueva entre.
!macro VilcanetSoltarBiblioteca archivo
    ${If} ${FileExists} "$INSTDIR\bin\${archivo}"
        Delete "$INSTDIR\bin\${archivo}"
        ${If} ${FileExists} "$INSTDIR\bin\${archivo}"
            Delete "$INSTDIR\bin\${archivo}.viejo"
            Rename "$INSTDIR\bin\${archivo}" "$INSTDIR\bin\${archivo}.viejo"
            Delete /REBOOTOK "$INSTDIR\bin\${archivo}.viejo"
        ${EndIf}
    ${EndIf}
!macroend

;--------------------------------
; Marca: icono, lateral y cabecera

;!define MUI_ICON
@{installerIcon}
;!define MUI_ICON
!define MUI_UNICON "@{icon}"

!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "@{vilcanet_dir}\page_header.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "@{vilcanet_dir}\page_header.bmp"
!define MUI_WELCOMEFINISHPAGE_BITMAP "@{vilcanet_dir}\welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "@{vilcanet_dir}\welcome.bmp"
!define MUI_ABORTWARNING

!insertmacro MUI_PAGE_WELCOME

;!insertmacro MUI_PAGE_LICENSE
@{license}
;!insertmacro MUI_PAGE_LICENSE

;!insertmacro MUI_FINISHPAGE_SHOWREADME
@{readme}
;!insertmacro MUI_FINISHPAGE_SHOWREADME

!insertmacro MULTIUSER_PAGE_INSTALLMODE
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_STARTMENU Application $StartMenuFolder

!define MUI_COMPONENTSPAGE_NODESC
;!insertmacro MUI_PAGE_COMPONENTS
@{sections_page}
;!insertmacro MUI_PAGE_COMPONENTS

!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!define MUI_FINISHPAGE_LINK "$(VN_SITIO)"
!define MUI_FINISHPAGE_LINK_LOCATION "@{website}"
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "English"

; Idioma: el de Windows si es espanol o ingles; cualquier otro, espanol (el primero de la lista).
; No se llama a MUI_LANGDLL_DISPLAY: el instalador no pregunta el idioma.
; Solo ASCII en este archivo: las letras con tilde van como ${U+xxxx}.
LangString VN_ABIERTO ${LANG_SPANISH} "@{productname} est${U+00E1} abierto:$\n$\n$ProcessList$\nPulse $\"S${U+00ED}$\" para cerrarlo y continuar, $\"No$\" para volver a comprobar o $\"Cancelar$\" para salir."
LangString VN_ABIERTO ${LANG_ENGLISH} "@{productname} is running:$\n$\n$ProcessList$\nPress $\"Yes$\" to close it and continue, $\"No$\" to check again or $\"Cancel$\" to quit."
LangString VN_EXTENSION ${LANG_SPANISH} "Extensi${U+00F3}n del Explorador"
LangString VN_EXTENSION ${LANG_ENGLISH} "Explorer extension"
LangString VN_SITIO ${LANG_SPANISH} "Visitar el sitio de Vilcanet"
LangString VN_SITIO ${LANG_ENGLISH} "Visit the Vilcanet website"
LangString VN_SOLO64 ${LANG_SPANISH} "Este instalador solo funciona en Windows de 64 bits."
LangString VN_SOLO64 ${LANG_ENGLISH} "This installer only works on 64-bit Windows."
LangString VN_SOLOUSUARIO ${LANG_SPANISH} "Instalaci${U+00F3}n solo para este usuario: sin iconos de estado ni men${U+00FA} en el Explorador."
LangString VN_SOLOUSUARIO ${LANG_ENGLISH} "Installed for this user only: no status icons or Explorer menu."
LangString VN_DESINSTALAR ${LANG_SPANISH} "Se va a desinstalar @{productname} de este equipo. Los archivos de su carpeta sincronizada no se borran."
LangString VN_DESINSTALAR ${LANG_ENGLISH} "@{productname} will be removed from this computer. The files in your synchronized folder are not deleted."

SetDateSave on
SetDatablockOptimize on
CRCCheck on
SilentInstall normal

Function .onInit
    !insertmacro MULTIUSER_INIT
    !if "@{architecture}" == "x86_64"
        ${IfNot} ${RunningX64}
            MessageBox MB_OK|MB_ICONEXCLAMATION "$(VN_SOLO64)"
            Abort
        ${EndIf}
    !endif
FunctionEnd

Function un.onInit
    !insertmacro MULTIUSER_UNINIT
FunctionEnd

;--------------------------------

AutoCloseWindow false


; beginning (invisible) section
Section
  !insertmacro VilcanetCerrarConAviso
  ExecWait '"$MultiUser.InstDir\uninstall.exe" /S _?=$MultiUser.InstDir'
  @{preInstallHook}
  WriteRegStr SHCTX "${regkey}" "Install_Dir" "$INSTDIR"
  WriteRegStr SHCTX "${MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_KEY}" "${MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_VALUENAME}" "$MultiUser.InstallMode"
  ; write uninstall strings
  WriteRegStr SHCTX "${uninstkey}" "DisplayName" "@{productname}"
  WriteRegStr SHCTX "${uninstkey}" "UninstallString" '"$INSTDIR\uninstall.exe"'
  WriteRegStr SHCTX "${uninstkey}" "DisplayIcon" "$INSTDIR\@{iconname}"
  WriteRegStr SHCTX "${uninstkey}" "URLInfoAbout" "@{website}"
  WriteRegStr SHCTX "${uninstkey}" "Publisher" "@{company}"
  WriteRegStr SHCTX "${uninstkey}" "DisplayVersion" "@{version}"
  WriteRegDWORD SHCTX "${uninstkey}" "EstimatedSize" "@{estimated_size}"

  @{registry_hook}

  SetOutPath $INSTDIR

  ; si quedo una biblioteca del Explorador de la version anterior, se aparta antes de copiar
  !insertmacro VilcanetSoltarBiblioteca "NCOverlays.dll"
  !insertmacro VilcanetSoltarBiblioteca "NCContextMenu.dll"

; package all files, recursively, preserving attributes
; assume files are in the correct places

File /a "@{dataPath}"
File /a "@{7za}"
File /a "@{icon}"
nsExec::ExecToLog '"$INSTDIR\7za.exe" x -r -y "$INSTDIR\@{dataName}" -o"$INSTDIR"'
Pop $0
Delete "$INSTDIR\7za.exe"
Delete "$INSTDIR\@{dataName}"

AddSize @{installSize}

WriteUninstaller "uninstall.exe"

  ${If} $MultiUser.InstallMode == "AllUsers"
    !insertmacro VilcanetRegistrarExtension "NCOverlays.dll"
    !insertmacro VilcanetRegistrarExtension "NCContextMenu.dll"
  ${Else}
    DetailPrint "$(VN_SOLOUSUARIO)"
  ${EndIf}

SectionEnd

; create shortcuts
@{shortcuts}

;  allow to define additional sections
@{sections}


; Uninstaller
; All section names prefixed by "Un" will be in the uninstaller

UninstallText "$(VN_DESINSTALAR)"

Section "Uninstall"
!insertmacro VilcanetCerrarConAviso

${If} $MultiUser.InstallMode == "AllUsers"
  !insertmacro VilcanetQuitarExtension "NCOverlays.dll"
  !insertmacro VilcanetQuitarExtension "NCContextMenu.dll"
${EndIf}
!insertmacro VilcanetSoltarBiblioteca "NCOverlays.dll"
!insertmacro VilcanetSoltarBiblioteca "NCContextMenu.dll"

; Inicio con Windows: lo escribe el programa. Se quita solo al desinstalar a mano;
; al actualizar (desinstalacion silenciosa) se conserva.
${IfNot} ${Silent}
  DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "@{vilcanet_shortname}"
${EndIf}

DeleteRegKey SHCTX "${uninstkey}"
DeleteRegKey SHCTX "${regkey}"

!insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuFolder
RMDir /r "$SMPROGRAMS\$StartMenuFolder"

@{uninstallFiles}
@{uninstallDirs}

; si una biblioteca quedo apartada hasta el reinicio, las carpetas se terminan de quitar entonces
${IfNot} ${Silent}
  RMDir /REBOOTOK "$INSTDIR\bin"
  RMDir /REBOOTOK "$INSTDIR"
${EndIf}

SectionEnd

;  allow to define additional Un.sections
@{un_sections}
